{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec next dev --port 3000", "cwd": "apps/web" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec next build", "cwd": "apps/web" },
      "outputs": ["{projectRoot}/.next"]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": { "command": "pnpm exec vitest run", "cwd": "apps/web" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec tsc --noEmit", "cwd": "apps/web" }
    }
  }
}
