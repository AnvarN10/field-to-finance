  [F2F Proto], [организация выпусков по договору с ТОО], [Arranging, если собирает инвесторов «от имени» ТОО; при работе с деньгами Dealing as Agent #V @fn-gen; либо подрядчик CC (вариант 1)],
  [CC], [площадка, клиринг], [#V @fn-reg-cc],
  [Binance KZ], [корпоративный счёт каждого ТОО: USDC в тенге], [#V @fn-dasp],
)

